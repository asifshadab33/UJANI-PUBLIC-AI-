{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ujani:personal-enterprise-task-contract:v1",
  "title": "UJANI Personal-to-Enterprise Task Contract",
  "description": "Draft language-neutral envelope, status and receipt messages. Schema validation does not authenticate, authorise or execute a task.",
  "oneOf": [
    {
      "$ref": "#/$defs/task_envelope"
    },
    {
      "$ref": "#/$defs/task_status"
    },
    {
      "$ref": "#/$defs/execution_receipt"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "task_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "schema_version",
        "task_id",
        "sender",
        "audience",
        "issued_at_unix_ms",
        "expires_at_unix_ms",
        "nonce",
        "operation_id",
        "operation_version",
        "payload",
        "data_classification",
        "privacy_classification",
        "required_scopes",
        "required_capabilities",
        "resource_limits",
        "network_access",
        "consent",
        "device_trust",
        "signature",
        "network_destinations"
      ],
      "properties": {
        "message_type": {
          "const": "task_envelope"
        },
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "sender": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_id",
            "device_id"
          ],
          "properties": {
            "principal_id": {
              "$ref": "#/$defs/identifier"
            },
            "device_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organisation_id",
            "service_id"
          ],
          "properties": {
            "organisation_id": {
              "$ref": "#/$defs/identifier"
            },
            "service_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "issued_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "operation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "byte_length",
            "media_type"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            },
            "media_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
            }
          }
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "privacy_classification": {
          "enum": [
            "none",
            "personal",
            "sensitive_personal",
            "regulated"
          ]
        },
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9._-]*$"
          }
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "chat",
              "reasoning",
              "coding",
              "vision",
              "embeddings",
              "tool_use",
              "streaming",
              "audio_input",
              "audio_output"
            ]
          }
        },
        "min_context_length_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_millis",
            "memory_mb",
            "max_runtime_ms",
            "max_output_bytes"
          ],
          "properties": {
            "cpu_millis": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304,
              "description": "Memory limit in mebibytes (MiB); 1 MiB equals 1,048,576 bytes."
            },
            "max_runtime_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800000
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          }
        },
        "network_access": {
          "enum": [
            "none",
            "enterprise_internal",
            "allowlisted"
          ]
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user",
            "required_approvals"
          ],
          "properties": {
            "user": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "consent_id",
                "subject_id",
                "granted_at_unix_ms",
                "expires_at_unix_ms",
                "binding_sha256"
              ],
              "properties": {
                "decision": {
                  "const": "granted"
                },
                "consent_id": {
                  "$ref": "#/$defs/identifier"
                },
                "subject_id": {
                  "$ref": "#/$defs/identifier"
                },
                "granted_at_unix_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "expires_at_unix_ms": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 9007199254740991
                },
                "binding_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "required_approvals": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "organisation_admin",
                  "worker_device_owner"
                ]
              }
            }
          }
        },
        "device_trust": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_device_id",
            "required_trust_state",
            "require_owner_opt_in"
          ],
          "properties": {
            "target_device_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "required_trust_state": {
              "const": "enrolled_active"
            },
            "require_owner_opt_in": {
              "const": true
            }
          }
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "network_destinations": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$",
            "not": {
              "pattern": "^(?:(?:[0-9]+|0[xX][0-9A-Fa-f]+)(?:\\.(?:[0-9]+|0[xX][0-9A-Fa-f]+)){0,3})$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network_access": {
                "const": "allowlisted"
              }
            },
            "required": [
              "network_access"
            ]
          },
          "then": {
            "properties": {
              "network_destinations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network_access": {
                "enum": [
                  "none",
                  "enterprise_internal"
                ]
              }
            },
            "required": [
              "network_access"
            ]
          },
          "then": {
            "properties": {
              "network_destinations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "task_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "schema_version",
        "task_id",
        "sequence",
        "state",
        "updated_at_unix_ms",
        "policy_version",
        "consent_state",
        "signature"
      ],
      "properties": {
        "message_type": {
          "const": "task_status"
        },
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "received",
            "validating",
            "awaiting_approval",
            "queued",
            "reserved",
            "running",
            "completed",
            "failed",
            "cancelled",
            "timed_out",
            "rejected",
            "expired"
          ]
        },
        "updated_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_version": {
          "$ref": "#/$defs/identifier"
        },
        "consent_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user",
            "organisation_admin",
            "worker_device_owner"
          ],
          "properties": {
            "user": {
              "enum": [
                "granted",
                "revoked"
              ]
            },
            "worker_device_owner": {
              "enum": [
                "pending",
                "approved",
                "denied",
                "revoked"
              ]
            },
            "organisation_admin": {
              "enum": [
                "pending",
                "approved",
                "denied",
                "revoked"
              ]
            }
          }
        },
        "reason_code": {
          "enum": [
            "invalid_signature",
            "unknown_sender",
            "wrong_audience",
            "expired",
            "replay",
            "payload_mismatch",
            "consent_denied",
            "policy_denied",
            "device_untrusted",
            "resource_unavailable",
            "unsupported_capability",
            "cancelled",
            "timeout",
            "internal_error",
            "consent_revoked"
          ]
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "reserved",
                  "running",
                  "completed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "consent_state": {
                "required": [
                  "user",
                  "organisation_admin",
                  "worker_device_owner"
                ],
                "properties": {
                  "user": {
                    "const": "granted"
                  },
                  "organisation_admin": {
                    "const": "approved"
                  },
                  "worker_device_owner": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "cancelled",
                  "timed_out",
                  "rejected",
                  "expired"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    },
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_type",
        "schema_version",
        "task_id",
        "sequence",
        "input_sha256",
        "output_sha256",
        "output_byte_length",
        "worker",
        "execution_location",
        "started_at_unix_ms",
        "completed_at_unix_ms",
        "outcome",
        "consent_refs",
        "policy_version",
        "signature"
      ],
      "properties": {
        "message_type": {
          "const": "execution_receipt"
        },
        "schema_version": {
          "const": 1
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organisation_id",
            "device_id"
          ],
          "properties": {
            "organisation_id": {
              "$ref": "#/$defs/identifier"
            },
            "device_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "execution_location": {
          "enum": [
            "enrolled_device",
            "enterprise_service"
          ]
        },
        "started_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "completed_at_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "timed_out"
          ]
        },
        "resource_usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu_time_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "peak_memory_mb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Peak resident memory in mebibytes (MiB); 1 MiB equals 1,048,576 bytes."
            },
            "elapsed_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "consent_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_consent_id",
            "organisation_approval_id",
            "worker_owner_consent_id"
          ],
          "properties": {
            "user_consent_id": {
              "$ref": "#/$defs/identifier"
            },
            "worker_owner_consent_id": {
              "$ref": "#/$defs/identifier"
            },
            "organisation_approval_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "policy_version": {
          "$ref": "#/$defs/identifier"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "output_byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864,
          "description": "Number of output bytes covered by output_sha256; zero requires a null digest."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "output_byte_length": {
                "const": 0
              }
            },
            "required": [
              "output_byte_length"
            ]
          },
          "then": {
            "properties": {
              "output_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "output_byte_length": {
                "minimum": 1
              }
            },
            "required": [
              "output_byte_length"
            ]
          },
          "then": {
            "properties": {
              "output_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  }
}
